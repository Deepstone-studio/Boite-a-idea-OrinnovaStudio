{
  "name": "boite-a-idees",
  "version": "1.0.2",
  "description": "Boîte à idées - application desktop Electron pour capturer et organiser vos idées",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux AppImage",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.orinnova.boite-a-idees",
    "productName": "Boite-a-idees",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "updater.js",
      "public/**/*"
    ],
    "asar": true,
    "win": {
      "target": ["nsis"],
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "public/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "icon": "public/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "Deepstone-studio",
      "repo": "Boite-a-idea-OrinnovaStudio",
      "releaseType": "release"
    }
  },
  "keywords": [
    "ideas",
    "notes",
    "sqlite",
    "electron"
  ],
  "author": "Orinnova Studio",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8"
  }
}
