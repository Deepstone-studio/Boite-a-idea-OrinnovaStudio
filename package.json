{
  "name": "boite-a-idees",
  "version": "1.0.0",
  "description": "Boîte à idées - application desktop Electron pour capturer et organiser vos idées",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.orinstone.boite-a-idees",
    "productName": "Boîte à idées",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "public/**/*",
      "node_modules/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "Deepstone-studio",
      "repo": "Boite-a-idea-OrinnovaStudio",
      "releaseType": "release"
    }
  },
  "keywords": [
    "ideas",
    "notes",
    "sqlite",
    "electron"
  ],
  "author": "Orinstone Studio",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.10.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "electron": "^45.0.0"
  }
}
